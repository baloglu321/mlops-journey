# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Proxy configuration (leave as is for local proxy)
OPENAI_API_KEY="sk-1234"
OPENAI_BASE_URL="http://localhost:4000"

# Your Ollama server URL (replace with your actual URL)
OLLAMA_API_URL="your-ollama-server-url-here"

# Your Semgrep App Token (get from https://semgrep.dev/orgs/-/settings/tokens)
SEMGREP_APP_TOKEN="your-semgrep-token-here"
